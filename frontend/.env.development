# Loaded by `vite dev` only — NOT by `vite build`.
#
# Kept dev-only on purpose: a plain `.env` is read during production builds
# too, which would bake localhost into a deployable bundle. The production
# URL is the built-in default in src/api/tripApi.js, so builds need no env
# file at all.
VITE_API_BASE_URL=http://localhost:8000
