# ============================================================
# TripSaathi Environment Variables
# ============================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# NEVER commit .env to git — it contains secrets!
# ============================================================

# --- LLM Provider (Groq) ---
# Get your free API key at: https://console.groq.com
# Sign up → API Keys → Create API Key
# Free tier: ~30 requests/minute, more than enough for development
GROQ_API_KEY=gsk_your_api_key_here

# --- LLM Model ---
# Groq offers several models. Recommended:
#   - llama-3.1-70b-versatile: Best quality, good for complex reasoning
#   - llama-3.1-8b-instant: Faster, cheaper, good for simple tasks
#   - mixtral-8x7b-32768: Good balance of speed and quality
LLM_MODEL_NAME=llama-3.1-70b-versatile

# --- LLM Parameters ---
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# --- Database (PostgreSQL) ---
# The app reads this from the environment only — nothing is hardcoded.
#
# Paste the provider's connection string as-is. app/db/database.py normalises
# it: the driver is switched to asyncpg, libpq-only parameters (sslmode,
# channel_binding) are translated or dropped, and prepared-statement caching
# is disabled automatically against a pgbouncer "-pooler" endpoint.
#
#   Local (Homebrew):  postgresql://localhost:5432/tripsaathi
#   Neon / Supabase:   postgresql://USER:PASSWORD@HOST/DB?sslmode=require
#
# In production this is set on the platform (Cloud Run --set-env-vars or a
# Secret Manager secret), never in a file.
DATABASE_URL=postgresql://localhost:5432/tripsaathi

# --- ChromaDB ---
# Directory where ChromaDB stores vector embeddings persistently
CHROMA_PERSIST_DIR=./chroma_db

# --- RAG Settings ---
# Number of document chunks to retrieve per query
RAG_TOP_K=5

# Chunk size for text splitting (in characters)
RAG_CHUNK_SIZE=1000

# Overlap between chunks (helps maintain context across splits)
RAG_CHUNK_OVERLAP=200

# --- Server ---
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# --- Logging ---
LOG_LEVEL=INFO
